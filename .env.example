# === StudyOS environment variables ===
# Copy this file to ".env" and fill in the real values. NEVER commit ".env".

# --- App ---
# Port the backend server listens on.
PORT=3100
# Timezone used for all date/time logic.
TZ=Asia/Bangkok
# Node environment: development | production
NODE_ENV=development

# --- Auth (single user) ---
# The one password used to log in. Choose something strong.
APP_PASSWORD=change-me
# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Path to the SQLite database file.
DB_PATH=./data/studyos.db

# --- File uploads ---
# Where uploaded note photos are stored on disk.
UPLOAD_DIR=./data/uploads

# --- AI ---
# DeepSeek (preferred): with this set, every AI call uses DeepSeek V4 Flash through
# DeepSeek's Anthropic-compatible API. Optional: DEEPSEEK_MODEL (default deepseek-flash).
DEEPSEEK_API_KEY=sk-xxxxxxxx
# Anthropic: used only when DEEPSEEK_API_KEY is empty. Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model to use. Can be swapped later without code changes.
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: Workspace ID (only needed for org-level API keys).
# ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxx

# --- Notifications when the app is closed (Web Push) ---
# A contact address push services may use about this sender. Use a real one before launch.
# VAPID_SUBJECT=mailto:you@your-domain
# Optional: fix the signing keys here. If left out, the server makes a pair on
# first start and keeps it in the database. Never change them once students
# have turned notifications on, or their devices stop receiving.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Sign-in ---
# Google sign-in (the only way to sign in on a live site). From Google Cloud Console > Credentials.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# The public address of the app; the Google callback is APP_URL + /api/auth/google/callback.
# APP_URL=http://localhost:3100
# After the site moves: its old addresses, comma-separated. Requests that still arrive at one
# are sent on to the same page under APP_URL.
# MOVED_FROM=https://old.example.com/app,https://www.example.com
# The iOS app signs in with Google through the same client; the sign-in returns to the app at
# this URL scheme (the app's bundle identifier). Change it only if the app's identifier changes.
# IOS_APP_SCHEME=com.patrick.termtrail
# With no Google client set, a password-less "dev login" (any email) is offered in development.
# In production it is OFF unless this is set on purpose. Never leave it on with real students.
# ALLOW_DEV_LOGIN=true

# --- A trial copy under a sub-path (docs/DEPLOY_SUBPATH.md) ---
# Serve the whole app under a path of an existing site. The client must be BUILT with
# the same value:  BASE_PATH=/termtrail npm run build
# BASE_PATH=/termtrail
# Address to listen on. Leave unset in a container; 127.0.0.1 behind a tunnel on the same machine.
# HOST=127.0.0.1
# With ALLOW_DEV_LOGIN=true: the access code a visitor must give to sign in.
# DEV_LOGIN_CODE=

# Optional. A Google Maps key for the Maps Embed API: walking directions then open on a Google
# map inside the app (without it they open in Google Maps). Restrict the key at Google to the
# Maps Embed API and to this site's address: it is sent to signed-in browsers.
GOOGLE_MAPS_EMBED_KEY=
