{
  "name": "study-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StudyOS - personal study system for RU Psychology (I/O major)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run typecheck --workspace server",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "seed": "npm run seed --workspace server",
    "start": "npm run start --workspace server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
